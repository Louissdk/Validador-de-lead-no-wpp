POSTGRES_PASSWORD=change_me_local_password
DATABASE_URL=postgresql://kael:change_me_local_password@db:5432/kael
REDIS_URL=redis://redis:6379/0

EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

SEND_MODE=dry_run
ALLOW_MARKETING_SENDS=false
LIVE_SEND_CONFIRMATION=
WEBHOOK_SECRET=change_me_use_a_long_random_secret

TIMEZONE=America/Sao_Paulo
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=18
MAX_MESSAGES_PER_DAY=20
MIN_SECONDS_BETWEEN_MESSAGES=45
WORKER_POLL_SECONDS=5
REQUEST_TIMEOUT_SECONDS=20

# Planejamento de leads no Google Sheets (credenciais ficam apenas na máquina local)
GOOGLE_SHEETS_ID=
GOOGLE_CREDS_FILE=credentials.json
GOOGLE_SOURCE_TAB=leads_validados
GOOGLE_OUTPUT_TAB=kael_planejamento
GOOGLE_CONSOLIDATION_SOURCE_TAB=kael_revalidacao_v2
GOOGLE_CONSOLIDATION_OUTPUT_TAB=kael_leads_consolidados_preview_v5

# Proteção de cota Google Sheets: intervalo entre chamadas e tentativas de retry
KAEL_SHEETS_MIN_INTERVAL_SECONDS=1.25
KAEL_SHEETS_MAX_RETRIES=6
